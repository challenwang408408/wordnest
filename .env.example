# 家庭访问码（生产必须换成自己的强密码）
FAMILY_ACCESS_CODE=change-me-family-code

# 会话签名密钥（生产必须换成随机长字符串）
SESSION_SECRET=change-me-session-secret-at-least-32-chars

# AI Builders Token（仅从环境变量读取，勿提交）
AI_BUILDER_TOKEN=

# 数据库：优先 DATABASE_URL，否则使用 DATA_DIR/wordnest.db
# DATABASE_URL=sqlite:////var/data/wordnest.db
DATA_DIR=./data

# 生产环境设为 production，启用 Secure Cookie 等
APP_ENV=development

# 前端生产挂载子路径（与 Vite 生产 base 对齐；API 仍为 /api/wordnest）
FRONTEND_BASE_PATH=/projects/wordnest
FAMILY_TIMEZONE=Asia/Shanghai

# AI 请求超时（秒）
AI_TIMEOUT_SECONDS=60

# AI Builders OpenAI 兼容接口；通常无需修改
AI_BASE_URL=https://space.ai-builders.com/backend/v1
